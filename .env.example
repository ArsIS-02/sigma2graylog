# Graylog, к которому подключаемся
GRAYLOG_URL=http://graylog.example.com:9000
# Адрес Graylog для ссылок в интерфейсе (с других хостов должно резолвиться).
# Адрес, который резолвится с рабочих машин (например, IP или DNS-имя)
GRAYLOG_PUBLIC_URL=http://graylog.example.com:9000

GRAYLOG_USER=admin
GRAYLOG_PASSWORD=CHANGE_ME
# Альтернатива логину/паролю: API-токен (Settings → API tokens)
# GRAYLOG_TOKEN=

# Логин/пароль интерфейса. Используются ТОЛЬКО при первом старте — создаётся
# /data/users.json. Дальше пароль меняется в самом интерфейсе (меню под аватаром).
APP_USER=sigma
APP_PASSWORD=CHANGE_ME

# Кэш списка полей, секунды
FIELDS_TTL=600
