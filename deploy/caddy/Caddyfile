# Caddy сам получает и продлевает сертификат Let's Encrypt.
# caddy run --config Caddyfile

sigma.example.com {
    encode zstd gzip
    request_body {
        max_size 64MB
    }
    reverse_proxy 127.0.0.1:8080 {
        header_up X-Forwarded-Proto {scheme}
        transport http {
            read_timeout 300s
        }
    }
}
